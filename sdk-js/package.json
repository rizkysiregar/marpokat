{
  "name": "marpokat-sdk-js",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "gen": "npm run gen -w @marpokat/core",
    "build": "npm run build -w @marpokat/core && npm run build -w @marpokat/react",
    "test": "npm test -w @marpokat/core && npm test -w @marpokat/react",
    "typecheck": "npm run typecheck -w @marpokat/core && npm run typecheck -w @marpokat/react"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "tsup": "8.5.0",
    "vitest": "3.2.4",
    "openapi-typescript": "7.8.0",
    "fake-indexeddb": "6.0.1",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react-dom": "19.1.6"
  }
}
