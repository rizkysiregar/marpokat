# Local development against docker-compose.yml. Copy to .env (git-ignored); the Makefile loads it.
LOG_LEVEL=debug
HTTP_ADDR=:8080
MANAGEMENT_ADDR=:9090

# through pgbouncer (transaction mode), like dev and prod
POSTGRES_HOST=localhost
POSTGRES_PORT=56432
POSTGRES_DATABASE=marpokat
POSTGRES_USER=marpokat
POSTGRES_PASSWORD=marpokat

REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=marpokat
REDIS_KEY_PREFIX=marpokat:

RABBITMQ_HOST=localhost
RABBITMQ_PORT=55672
RABBITMQ_USERNAME=marpokat
RABBITMQ_PASSWORD=marpokat
RABBITMQ_VIRTUAL_HOST=/marpokat-dev

MINIO_ENDPOINT=http://localhost:59000
MINIO_ACCESS_KEY=marpokat
MINIO_SECRET_KEY=marpokat-secret
MINIO_BUCKET=marpokat-media-dev

# local only, never reuse: openssl rand -base64 32
MARPOKAT_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
